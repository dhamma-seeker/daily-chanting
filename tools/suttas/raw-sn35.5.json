[
 {
  "segment_id": "sn35.5:0.1",
  "pali": "Saṁyutta Nikāya 35.5",
  "en": "Linked Discourses 35.5"
 },
 {
  "segment_id": "sn35.5:0.2",
  "pali": "1. Aniccavagga",
  "en": "1. Impermanence"
 },
 {
  "segment_id": "sn35.5:0.3",
  "pali": "Bāhiradukkhasutta",
  "en": "The Exterior as Suffering"
 },
 {
  "segment_id": "sn35.5:1.1",
  "pali": "“Rūpā, bhikkhave, dukkhā.",
  "en": "“Mendicants, sights are suffering."
 },
 {
  "segment_id": "sn35.5:1.2",
  "pali": "Yaṁ dukkhaṁ tadanattā;",
  "en": "What’s suffering is not-self."
 },
 {
  "segment_id": "sn35.5:1.3",
  "pali": "yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ.",
  "en": "And what’s not-self should be truly seen with right understanding like this: ‘This is not mine, I am not this, this is not my self.’ …”"
 },
 {
  "segment_id": "sn35.5:1.4",
  "pali": "Saddā …",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.5",
  "pali": "gandhā …",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.6",
  "pali": "rasā …",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.7",
  "pali": "phoṭṭhabbā …",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.8",
  "pali": "dhammā dukkhā.",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.9",
  "pali": "Yaṁ dukkhaṁ tadanattā.",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.10",
  "pali": "Yadanattā taṁ ‘netaṁ mama, nesohamasmi, na meso attā’ti evametaṁ yathābhūtaṁ sammappaññāya daṭṭhabbaṁ.",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.11",
  "pali": "Evaṁ passaṁ …pe…",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.12",
  "pali": "nāparaṁ itthattāyāti pajānātī”ti.",
  "en": null
 },
 {
  "segment_id": "sn35.5:1.13",
  "pali": "Pañcamaṁ.",
  "en": null
 }
]