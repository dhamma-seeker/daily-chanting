[
 {
  "segment_id": "snp1.8:0.1",
  "pali": "Sutta Nipāta 1.8",
  "en": "Anthology of Discourses 1.8"
 },
 {
  "segment_id": "snp1.8:0.2",
  "pali": "Mettasutta",
  "en": "The Discourse on Love"
 },
 {
  "segment_id": "snp1.8:1.1",
  "pali": "“Karaṇīyamatthakusalena,",
  "en": "Those who are skilled in the meaning of scripture"
 },
 {
  "segment_id": "snp1.8:1.2",
  "pali": "Yanta santaṁ padaṁ abhisamecca;",
  "en": "should practice as follows <j>to realize the state of peace."
 },
 {
  "segment_id": "snp1.8:1.3",
  "pali": "Sakko ujū ca suhujū ca,",
  "en": "Let them be capable and upright, very upright,"
 },
 {
  "segment_id": "snp1.8:1.4",
  "pali": "Sūvaco cassa mudu anatimānī.",
  "en": "easy to speak to, gentle and humble;"
 },
 {
  "segment_id": "snp1.8:2.1",
  "pali": "Santussako ca subharo ca,",
  "en": "content and unburdensome,"
 },
 {
  "segment_id": "snp1.8:2.2",
  "pali": "Appakicco ca sallahukavutti;",
  "en": "unbusied, living lightly,"
 },
 {
  "segment_id": "snp1.8:2.3",
  "pali": "Santindriyo ca nipako ca,",
  "en": "alert, with senses calmed,"
 },
 {
  "segment_id": "snp1.8:2.4",
  "pali": "Appagabbho kulesvananugiddho.",
  "en": "courteous, not fawning on families."
 },
 {
  "segment_id": "snp1.8:3.1",
  "pali": "Na ca khuddamācare kiñci,",
  "en": "Let them not do the slightest thing"
 },
 {
  "segment_id": "snp1.8:3.2",
  "pali": "Yena viññū pare upavadeyyuṁ;",
  "en": "that others who are wise would blame."
 },
 {
  "segment_id": "snp1.8:3.3",
  "pali": "Sukhino va khemino hontu,",
  "en": "May they be happy and safe!"
 },
 {
  "segment_id": "snp1.8:3.4",
  "pali": "Sabbasattā bhavantu sukhitattā.",
  "en": "May all beings be happy!"
 },
 {
  "segment_id": "snp1.8:4.1",
  "pali": "Ye keci pāṇabhūtatthi,",
  "en": "Whatever living creatures there are"
 },
 {
  "segment_id": "snp1.8:4.2",
  "pali": "Tasā vā thāvarā vanavasesā;",
  "en": "with not a one left out—"
 },
 {
  "segment_id": "snp1.8:4.3",
  "pali": "Dīghā vā ye va mahantā,",
  "en": "frail or firm, long or large,"
 },
 {
  "segment_id": "snp1.8:4.4",
  "pali": "Majjhimā rassakā aṇukathūlā.",
  "en": "medium, small, tiny or round,"
 },
 {
  "segment_id": "snp1.8:5.1",
  "pali": "Diṭṭhā vā ye va adiṭṭhā,",
  "en": "seen or unseen,"
 },
 {
  "segment_id": "snp1.8:5.2",
  "pali": "Ye va dūre vasanti avidūre;",
  "en": "living far or near,"
 },
 {
  "segment_id": "snp1.8:5.3",
  "pali": "Bhūtā va sambhavesī va,",
  "en": "those who have been born <j>and those about to be born—"
 },
 {
  "segment_id": "snp1.8:5.4",
  "pali": "Sabbasattā bhavantu sukhitattā.",
  "en": "may all beings be happy!"
 },
 {
  "segment_id": "snp1.8:6.1",
  "pali": "Na paro paraṁ nikubbetha,",
  "en": "Let none deceive another,"
 },
 {
  "segment_id": "snp1.8:6.2",
  "pali": "Nātimaññetha katthaci na kañci;",
  "en": "nor look down on anyone anywhere."
 },
 {
  "segment_id": "snp1.8:6.3",
  "pali": "Byārosanā paṭighasañña,",
  "en": "Though provoked or aggrieved,"
 },
 {
  "segment_id": "snp1.8:6.4",
  "pali": "Nāññamaññassa dukkhamiccheyya.",
  "en": "let them not wish pain on each other."
 },
 {
  "segment_id": "snp1.8:7.1",
  "pali": "Mātā yathā niyaṁ puttam",
  "en": "Even as a mother would protect with her life"
 },
 {
  "segment_id": "snp1.8:7.2",
  "pali": "Āyusā ekaputtamanurakkhe;",
  "en": "her child, her only child,"
 },
 {
  "segment_id": "snp1.8:7.3",
  "pali": "Evampi sabbabhūtesu,",
  "en": "so too for all creatures"
 },
 {
  "segment_id": "snp1.8:7.4",
  "pali": "Mānasaṁ bhāvaye aparimāṇaṁ.",
  "en": "unfold a boundless heart."
 },
 {
  "segment_id": "snp1.8:8.1",
  "pali": "Mettañca sabbalokasmi,",
  "en": "With love for the whole world,"
 },
 {
  "segment_id": "snp1.8:8.2",
  "pali": "Mānasaṁ bhāvaye aparimāṇaṁ;",
  "en": "unfold a boundless heart:"
 },
 {
  "segment_id": "snp1.8:8.3",
  "pali": "Uddhaṁ adho ca tiriyañca,",
  "en": "above, below, all round,"
 },
 {
  "segment_id": "snp1.8:8.4",
  "pali": "Asambādhaṁ averamasapattaṁ.",
  "en": "unconstricted, without enmity or foe."
 },
 {
  "segment_id": "snp1.8:9.1",
  "pali": "Tiṭṭhaṁ caraṁ nisinno va,",
  "en": "When standing, walking, sitting,"
 },
 {
  "segment_id": "snp1.8:9.2",
  "pali": "Sayāno yāvatāssa vitamiddho;",
  "en": "or lying down while yet unweary,"
 },
 {
  "segment_id": "snp1.8:9.3",
  "pali": "Etaṁ satiṁ adhiṭṭheyya,",
  "en": "keep this ever in mind;"
 },
 {
  "segment_id": "snp1.8:9.4",
  "pali": "Brahmametaṁ vihāramidhamāhu.",
  "en": "for this, they say, is a divine meditation <j>in this life."
 },
 {
  "segment_id": "snp1.8:10.1",
  "pali": "Diṭṭhiñca anupaggamma,",
  "en": "Avoiding harmful views,"
 },
 {
  "segment_id": "snp1.8:10.2",
  "pali": "Sīlavā dassanena sampanno;",
  "en": "virtuous, accomplished in insight,"
 },
 {
  "segment_id": "snp1.8:10.3",
  "pali": "Kāmesu vinaya gedhaṁ,",
  "en": "with desire for sensual pleasures dispelled,"
 },
 {
  "segment_id": "snp1.8:10.4",
  "pali": "Na hi jātuggabbhaseyya punaretī”ti.",
  "en": "they never return to a womb again."
 },
 {
  "segment_id": "snp1.8:10.5",
  "pali": "Mettasuttaṁ aṭṭhamaṁ.",
  "en": null
 }
]