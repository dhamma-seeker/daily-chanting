[
 {
  "segment_id": "kp7:0.1",
  "pali": "Khuddakapāṭha 7",
  "en": "Basic Passages 7"
 },
 {
  "segment_id": "kp7:0.2",
  "pali": "Tirokuṭṭasutta",
  "en": "Outside the Walls"
 },
 {
  "segment_id": "kp7:1.1",
  "pali": "Tirokuṭṭesu tiṭṭhanti,",
  "en": "Outside the walls they stand and wait,"
 },
 {
  "segment_id": "kp7:1.2",
  "pali": "sandhisiṅghāṭakesu ca;",
  "en": "at the junctions and the crossroads."
 },
 {
  "segment_id": "kp7:1.3",
  "pali": "Dvārabāhāsu tiṭṭhanti,",
  "en": "Returning to their former homes"
 },
 {
  "segment_id": "kp7:1.4",
  "pali": "āgantvāna sakaṁ gharaṁ.",
  "en": "they wait beside the door posts."
 },
 {
  "segment_id": "kp7:2.1",
  "pali": "Pahūte annapānamhi,",
  "en": "But when lavish food and drink"
 },
 {
  "segment_id": "kp7:2.2",
  "pali": "khajjabhojje upaṭṭhite;",
  "en": "of many kinds is set out,"
 },
 {
  "segment_id": "kp7:2.3",
  "pali": "Na tesaṁ koci sarati,",
  "en": "no-one remembers them at all,"
 },
 {
  "segment_id": "kp7:2.4",
  "pali": "sattānaṁ kammapaccayā.",
  "en": "because of those beings’s deeds."
 },
 {
  "segment_id": "kp7:3.1",
  "pali": "Evaṁ dadanti ñātīnaṁ,",
  "en": "That’s why those who have compassion"
 },
 {
  "segment_id": "kp7:3.2",
  "pali": "ye honti anukampakā;",
  "en": "give to their relatives"
 },
 {
  "segment_id": "kp7:3.3",
  "pali": "Suciṁ paṇītaṁ kālena,",
  "en": "food and drink at the right time,"
 },
 {
  "segment_id": "kp7:3.4",
  "pali": "kappiyaṁ pānabhojanaṁ.",
  "en": "that’s clean, delicious, and suitable."
 },
 {
  "segment_id": "kp7:4.1",
  "pali": "Idaṁ vo ñātīnaṁ hotu,",
  "en": "“May this be for our relatives!"
 },
 {
  "segment_id": "kp7:4.2",
  "pali": "sukhitā hontu ñātayo;",
  "en": "May our relatives be happy!”"
 },
 {
  "segment_id": "kp7:4.3",
  "pali": "Te ca tattha samāgantvā,",
  "en": "Those ghosts who have gathered there,"
 },
 {
  "segment_id": "kp7:4.4",
  "pali": "ñātipetā samāgatā.",
  "en": "the departed relatives who have come"
 },
 {
  "segment_id": "kp7:5.1",
  "pali": "Pahūte annapānamhi,",
  "en": "for the lavish food and drink"
 },
 {
  "segment_id": "kp7:5.2",
  "pali": "sakkaccaṁ anumodare;",
  "en": "gratefully express appreciation:"
 },
 {
  "segment_id": "kp7:5.3",
  "pali": "Ciraṁ jīvantu no ñātī,",
  "en": "“May our relatives live long!"
 },
 {
  "segment_id": "kp7:5.4",
  "pali": "yesaṁ hetu labhāmase.",
  "en": "For those to whom we owe this gain,"
 },
 {
  "segment_id": "kp7:6.1",
  "pali": "Amhākañca katā pūjā,",
  "en": "who have given honor to us,"
 },
 {
  "segment_id": "kp7:6.2",
  "pali": "dāyakā ca anipphalā;",
  "en": "it will not be fruitless for the donor.”"
 },
 {
  "segment_id": "kp7:6.3",
  "pali": "Na hi tattha kasī atthi,",
  "en": "There is no farming there,"
 },
 {
  "segment_id": "kp7:6.4",
  "pali": "gorakkhettha na vijjati.",
  "en": "no cow pasture can be found;"
 },
 {
  "segment_id": "kp7:7.1",
  "pali": "Vaṇijjā tādisī natthi,",
  "en": "likewise there’s no trading,"
 },
 {
  "segment_id": "kp7:7.2",
  "pali": "hiraññena kayākayaṁ;",
  "en": "and no commerce in gold coin."
 },
 {
  "segment_id": "kp7:7.3",
  "pali": "Ito dinnena yāpenti,",
  "en": "The departed, the dead in that place"
 },
 {
  "segment_id": "kp7:7.4",
  "pali": "petā kālagatā tahiṁ.",
  "en": "live on what is given here."
 },
 {
  "segment_id": "kp7:8.1",
  "pali": "Unname udakaṁ vuṭṭhaṁ,",
  "en": "Just as water that rains on high"
 },
 {
  "segment_id": "kp7:8.2",
  "pali": "yathā ninnaṁ pavattati;",
  "en": "flows down to the plains,"
 },
 {
  "segment_id": "kp7:8.3",
  "pali": "Evamevaṁ ito dinnaṁ,",
  "en": "so too what is given here"
 },
 {
  "segment_id": "kp7:8.4",
  "pali": "petānaṁ upakappati.",
  "en": "aids the departed ghosts."
 },
 {
  "segment_id": "kp7:9.1",
  "pali": "Yathā vārivahā pūrā,",
  "en": "Just as the rivers full"
 },
 {
  "segment_id": "kp7:9.2",
  "pali": "paripūrenti sāgaraṁ;",
  "en": "swell the ocean seas"
 },
 {
  "segment_id": "kp7:9.3",
  "pali": "Evamevaṁ ito dinnaṁ,",
  "en": "so too what is given here"
 },
 {
  "segment_id": "kp7:9.4",
  "pali": "petānaṁ upakappati.",
  "en": "aids the departed ghosts."
 },
 {
  "segment_id": "kp7:10.1",
  "pali": "Adāsi me akāsi me,",
  "en": "Thinking: “They gave to me, they did for me,"
 },
 {
  "segment_id": "kp7:10.2",
  "pali": "ñāti mittā sakhā ca me;",
  "en": "they were my family, friend, comrade”,"
 },
 {
  "segment_id": "kp7:10.3",
  "pali": "Petānaṁ dakkhiṇaṁ dajjā,",
  "en": "give offerings to departed kin,"
 },
 {
  "segment_id": "kp7:10.4",
  "pali": "pubbe katamanussaraṁ.",
  "en": "remembering past deeds."
 },
 {
  "segment_id": "kp7:11.1",
  "pali": "Na hi ruṇṇaṁ vā soko vā,",
  "en": "For neither tears nor grief"
 },
 {
  "segment_id": "kp7:11.2",
  "pali": "yā caññā paridevanā;",
  "en": "or other lamentations"
 },
 {
  "segment_id": "kp7:11.3",
  "pali": "Na taṁ petānamatthāya,",
  "en": "are of any use to the departed,"
 },
 {
  "segment_id": "kp7:11.4",
  "pali": "evaṁ tiṭṭhanti ñātayo.",
  "en": "so long as their relatives stay like this."
 },
 {
  "segment_id": "kp7:12.1",
  "pali": "Ayañca kho dakkhiṇā dinnā,",
  "en": "This offering that has been given,"
 },
 {
  "segment_id": "kp7:12.2",
  "pali": "saṅghamhi suppatiṭṭhitā;",
  "en": "well placed in the Saṅgha,"
 },
 {
  "segment_id": "kp7:12.3",
  "pali": "Dīgharattaṁ hitāyassa,",
  "en": "is for their lasting welfare,"
 },
 {
  "segment_id": "kp7:12.4",
  "pali": "ṭhānaso upakappati.",
  "en": "and aids them right away."
 },
 {
  "segment_id": "kp7:13.1",
  "pali": "So ñātidhammo ca ayaṁ nidassito,",
  "en": "The relative’s duty has now been shown:"
 },
 {
  "segment_id": "kp7:13.2",
  "pali": "Petāna pūjā ca katā uḷārā;",
  "en": "how high honor to departed is performed,"
 },
 {
  "segment_id": "kp7:13.3",
  "pali": "Balañca bhikkhūnamanuppadinnaṁ,",
  "en": "how the mendicants can be kept strong,"
 },
 {
  "segment_id": "kp7:13.4",
  "pali": "Tumhehi puññaṁ pasutaṁ anappakanti.",
  "en": "and how no little merit is produced by you."
 },
 {
  "segment_id": "kp7:14.1",
  "pali": "Tirokuṭṭasuttaṁ.",
  "en": null
 }
]